---
import { getCollection } from "astro:content";
import WorkFilter from "../../components/work/WorkFilter.astro";
import ProjectListItem from "../../components/work/ProjectListItem.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sortByOrderThenDate, visibleEntries } from "../../lib/content";

const allWork = await getCollection("work");
const projects = sortByOrderThenDate(
  visibleEntries(
    allWork.filter((entry) => entry.data.lang === "en"),
    import.meta.env.PROD,
  ),
);
const categories = [...new Set(projects.map((entry) => entry.data.category))];
---

<BaseLayout
  title="Work"
  description="Independent products, interface infrastructure, and experiments from Bash AI Lab."
  lang="en"
  canonicalPath="/work/"
  translationPath="/zh/work/"
>
  <div class="site-frame work-archive">
    <header class="work-archive__header">
      <p class="meta-label">Independent software / Systems / Experiments</p>
      <h1 class="display-title">Work</h1>
      <p class="lead">
        Products and technical systems developed through research, constraint
        design, and hands-on implementation.
      </p>
    </header>

    <WorkFilter categories={categories} />

    <section class="work-archive__projects" aria-label="Project archive">
      {
        projects.map((entry, index) => (
          <ProjectListItem entry={entry} index={index} locale="en" />
        ))
      }
    </section>
  </div>
</BaseLayout>

<style>
  .work-archive {
    padding-block: clamp(4rem, 9vw, 8rem) clamp(5rem, 10vw, 9rem);
  }

  .work-archive__header {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(18rem, 1.15fr);
    gap: 1rem clamp(2rem, 8vw, 8rem);
    align-items: end;
    padding-block-end: clamp(3rem, 7vw, 6rem);
  }

  .work-archive__header > .meta-label {
    grid-column: 1 / -1;
    margin: 0;
  }

  .work-archive__header h1 {
    align-self: end;
  }

  .work-archive__header .lead {
    margin: 0;
  }

  .work-archive__projects {
    display: block;
  }

  @media (max-width: 46rem) {
    .work-archive__header {
      grid-template-columns: 1fr;
    }

    .work-archive__header > .meta-label {
      grid-column: 1;
    }
  }
</style>
