---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BeforeAfter from "../../../components/mdx/BeforeAfter.astro";
import ConstraintFlow from "../../../components/mdx/ConstraintFlow.astro";
import MDXCallout from "../../../components/mdx/MDXCallout.astro";
import MetricBlock from "../../../components/mdx/MetricBlock.astro";
import QuoteBlock from "../../../components/mdx/QuoteBlock.astro";
import Timeline from "../../../components/mdx/Timeline.astro";
import ContentLayout from "../../../layouts/ContentLayout.astro";
import {
  contentSlug,
  estimateReadingMinutes,
  visibleEntries,
} from "../../../lib/content";
import { translationPath } from "../../../lib/localized-content";

export async function getStaticPaths() {
  const entries = await getCollection("research");
  return visibleEntries(entries, import.meta.env.PROD)
    .filter((entry) => entry.data.lang === "zh")
    .map((entry) => ({
      params: { slug: contentSlug(entry.id) },
      props: {
        entry,
        translationPath: translationPath(entries, entry, "research"),
      },
    }));
}

interface Props {
  entry: CollectionEntry<"research">;
  translationPath?: string;
}

const { entry, translationPath: counterpartPath } = Astro.props;
const { Content, headings } = await render(entry);
const sourceText =
  "body" in entry && typeof entry.body === "string"
    ? entry.body
    : entry.data.description;
const minutes = entry.data.readingMinutes ?? estimateReadingMinutes(sourceText);
const mdxComponents = {
  Callout: MDXCallout,
  Metric: MetricBlock,
  ConstraintFlow,
  Timeline,
  Quote: QuoteBlock,
  BeforeAfter,
};
---

<ContentLayout
  entry={entry}
  headings={headings}
  minutes={minutes}
  translationPath={counterpartPath}
>
  <Content components={mdxComponents} />
</ContentLayout>
