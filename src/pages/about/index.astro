---
import { getCollection, render } from "astro:content";
import EditorialPage from "../../components/content/EditorialPage.astro";

const entry = (await getCollection("pages")).find(
  (page) => page.id === "en/about" && !page.data.draft,
);

if (!entry) throw new Error("Missing approved About page content.");

const { Content } = await render(entry);
---

<EditorialPage entry={entry} translationPath="/zh/about/">
  <Content />
</EditorialPage>
