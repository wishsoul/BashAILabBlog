---
import { SITE } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title={SITE.title}
  description={SITE.description}
  lang="en"
  canonicalPath="/"
>
  <section
    class="site-frame shell-introduction flow"
    aria-labelledby="site-title"
  >
    <p class="meta-label">AI Product Research / Independent Software</p>
    <h1 id="site-title" class="display-title">{SITE.name}</h1>
    <p class="lead">{SITE.description}</p>
  </section>
</BaseLayout>

<style>
  .shell-introduction {
    --flow-space: clamp(1.25rem, 3vw, 2rem);
    display: grid;
    align-content: center;
    min-height: min(76svh, 52rem);
    padding-block: 5rem;
    border-block-end: 1px solid var(--color-border);
  }

  .shell-introduction .lead {
    margin-inline-start: min(12vw, 9rem);
  }

  @media (max-width: 40rem) {
    .shell-introduction .lead {
      margin-inline-start: 0;
    }
  }
</style>
