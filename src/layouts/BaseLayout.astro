---
import "@fontsource-variable/geist/index.css";
import "@fontsource-variable/geist-mono/index.css";
import type { Locale } from "../config/site";
import { SITE } from "../config/site";
import { getUi } from "../i18n";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHeader from "../components/navigation/SiteHeader.astro";
import {
  buildCanonical,
  buildLanguageAlternates,
  buildPersonJsonLd,
  buildWebsiteJsonLd,
  DEFAULT_OG_IMAGE,
} from "../lib/seo";
import { absoluteUrl, withBase } from "../lib/urls";
import "../styles/global.css";

type JsonLd = Record<string, unknown> | readonly Record<string, unknown>[];

export interface Props {
  title: string;
  description: string;
  lang: Locale;
  canonicalPath: string;
  image?: string;
  jsonLd?: JsonLd;
  translationPath?: string;
  openGraphType?: "article" | "website";
}

const {
  title,
  description,
  lang,
  canonicalPath,
  image,
  jsonLd,
  translationPath,
  openGraphType = "website",
} = Astro.props;
const ui = getUi(lang);
const pageTitle =
  title.includes(SITE.name) || title.includes(ui.brand)
    ? title
    : `${title} — ${ui.brand}`;
const canonicalUrl = buildCanonical(canonicalPath);
const socialImageUrl = absoluteUrl(image ?? DEFAULT_OG_IMAGE);
const faviconUrl = withBase("/favicon.svg");
const languageAlternates = buildLanguageAlternates({
  lang,
  canonicalPath,
  translationPath,
});
const jsonLdEntries = [
  buildPersonJsonLd(),
  buildWebsiteJsonLd(),
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
const serializedJsonLd = JSON.stringify(jsonLdEntries).replaceAll(
  "<",
  "\\u003c",
);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f5f1" />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="canonical" href={canonicalUrl} />
    {
      languageAlternates.map((alternate) => (
        <link
          rel="alternate"
          hreflang={alternate.hrefLang}
          href={alternate.href}
        />
      ))
    }

    <title>{pageTitle}</title>
    <meta property="og:type" content={openGraphType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    {
      (
        <script
          is:inline
          type="application/ld+json"
          set:html={serializedJsonLd}
        />
      )
    }

    <script is:inline>
      (() => {
        const root = document.documentElement;
        let storedTheme;

        try {
          storedTheme = localStorage.theme;
        } catch {
          storedTheme = undefined;
        }

        const theme =
          storedTheme === "light" || storedTheme === "dark"
            ? storedTheme
            : window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";

        root.dataset.theme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", theme === "dark" ? "#0b0b0c" : "#f5f5f1");
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {ui.accessibility.skipToMainContent}
    </a>
    <SiteHeader lang={lang} translationPath={translationPath} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    z-index: 100;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--color-text);
    color: var(--color-background);
    text-decoration: none;
    transform: translateY(-150%);
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }

  main {
    padding-block-start: var(--site-header-height);
  }
</style>
