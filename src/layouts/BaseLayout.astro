---
import "@fontsource-variable/geist/index.css";
import "@fontsource-variable/geist-mono/index.css";
import type { Locale } from "../config/site";
import { SITE } from "../config/site";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHeader from "../components/navigation/SiteHeader.astro";
import { absoluteUrl, withBase } from "../lib/urls";
import "../styles/global.css";

type JsonLd = Record<string, unknown> | readonly Record<string, unknown>[];

export interface Props {
  title: string;
  description: string;
  lang: Locale;
  canonicalPath: string;
  image?: string;
  jsonLd?: JsonLd;
  translationPath?: string;
}

const {
  title,
  description,
  lang,
  canonicalPath,
  image,
  jsonLd,
  translationPath,
} = Astro.props;
const pageTitle = title.includes(SITE.name) ? title : `${title} — ${SITE.name}`;
const canonicalUrl = absoluteUrl(canonicalPath);
const socialImageUrl = image ? absoluteUrl(image) : undefined;
const faviconUrl = withBase("/favicon.svg");
const serializedJsonLd = jsonLd
  ? JSON.stringify(jsonLd).replaceAll("<", "\\u003c")
  : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f5f1" />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="canonical" href={canonicalUrl} />

    <title>{pageTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    <meta
      name="twitter:card"
      content={socialImageUrl ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    {
      serializedJsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={serializedJsonLd}
        />
      )
    }

    <script is:inline>
      (() => {
        const root = document.documentElement;
        let storedTheme;

        try {
          storedTheme = localStorage.theme;
        } catch {
          storedTheme = undefined;
        }

        const theme =
          storedTheme === "light" || storedTheme === "dark"
            ? storedTheme
            : window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";

        root.dataset.theme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", theme === "dark" ? "#0b0b0c" : "#f5f5f1");
      })();
    </script>
  </head>
  <body>
    <SiteHeader lang={lang} translationPath={translationPath} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>

<style>
  main {
    padding-block-start: var(--site-header-height);
  }
</style>
