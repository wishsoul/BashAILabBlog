---
import type { CollectionEntry } from "astro:content";
import TableOfContents from "../components/content/TableOfContents.astro";
import TagList from "../components/content/TagList.astro";
import BackToTop from "../components/layout/BackToTop.astro";
import Breadcrumb from "../components/layout/Breadcrumb.astro";
import { getUi } from "../i18n";
import { displayContentLabel } from "../lib/content-labels";
import { contentPath, localizedPath } from "../lib/localized-content";
import { buildArticleJsonLd, DEFAULT_OG_IMAGE } from "../lib/seo";
import BaseLayout from "./BaseLayout.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: CollectionEntry<"research">;
  headings: Heading[];
  minutes: number;
  translationPath?: string;
}

const { entry, headings, minutes, translationPath } = Astro.props;
const locale = entry.data.lang;
const ui = getUi(locale);
const tableOfContentsHeadings = headings.filter(
  (heading) => heading.depth >= 2 && heading.depth <= 3,
);
const hasTableOfContents = tableOfContentsHeadings.length > 0;
const publishedAt = entry.data.publishedAt;
const publicationDate = publishedAt?.toISOString().slice(0, 10);
const publicationLabel = publishedAt
  ? new Intl.DateTimeFormat(locale === "zh" ? "zh-CN" : "en", {
      day: "2-digit",
      month: "short",
      year: "numeric",
      timeZone: "UTC",
    }).format(publishedAt)
  : undefined;
const canonicalPath = contentPath(locale, "research", entry.id);
const image = entry.data.seo.image?.src ?? DEFAULT_OG_IMAGE;
---

<BaseLayout
  title={entry.data.seo.title}
  description={entry.data.seo.description}
  lang={entry.data.lang}
  canonicalPath={canonicalPath}
  translationPath={translationPath}
  image={image}
  openGraphType="article"
  jsonLd={buildArticleJsonLd({
    title: entry.data.title,
    description: entry.data.description,
    canonicalPath,
    image,
    publishedAt: entry.data.publishedAt,
    updatedAt: entry.data.updatedAt,
  })}
>
  <article id="top" class="site-frame content-layout">
    <Breadcrumb
      locale={locale}
      items={[
        { label: ui.breadcrumb.home, href: localizedPath(locale, "/") },
        { label: ui.nav.research, href: localizedPath(locale, "/research/") },
        { label: entry.data.title },
      ]}
    />

    <header class="content-layout__header">
      <p class="meta-label">
        {displayContentLabel(locale, entry.data.category)} /
        {displayContentLabel(locale, entry.data.status)}
      </p>
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>
    </header>

    <section
      class="content-layout__metadata"
      aria-label={ui.metadata.publicationDetails}
      data-publication-metadata
    >
      {
        publicationDate && publicationLabel && (
          <time datetime={publicationDate}>{publicationLabel}</time>
        )
      }
      <span>{displayContentLabel(locale, entry.data.category)}</span>
      <span>{displayContentLabel(locale, entry.data.status)}</span>
      <span>{minutes} {ui.metadata.minutesRead}</span>
      <TagList
        tags={entry.data.tags}
        label={ui.metadata.tags(entry.data.title)}
      />
    </section>

    <div
      class:list={[
        "content-layout__body",
        {
          "content-layout__body--without-rail": !hasTableOfContents,
        },
      ]}
    >
      {
        hasTableOfContents && (
          <aside class="content-layout__rail">
            <TableOfContents
              headings={tableOfContentsHeadings}
              locale={locale}
            />
          </aside>
        )
      }
      <div class="content-layout__prose prose" data-content-prose>
        <slot />
      </div>
    </div>

    <footer class="content-layout__footer">
      <BackToTop locale={locale} />
    </footer>
  </article>
</BaseLayout>

<style>
  .content-layout {
    padding-block: 2rem clamp(5rem, 10vw, 9rem);
    scroll-margin-top: var(--site-header-height);
  }

  .content-layout__header {
    display: grid;
    gap: 1.5rem;
    max-width: 58rem;
    padding-block: clamp(3rem, 8vw, 7rem);
  }

  .content-layout__header > p {
    margin: 0;
  }

  .content-layout__header h1 {
    margin: 0;
    font-size: clamp(var(--font-size-2xl), 7vw, 5.5rem);
    font-weight: 550;
    letter-spacing: -0.07em;
    line-height: 0.92;
  }

  :global(html:lang(zh)) .content-layout h1 {
    letter-spacing: -0.035em;
  }

  .content-layout__metadata {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.25rem;
    align-items: center;
    padding-block: 1.25rem;
    border-block: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    letter-spacing: 0.04em;
  }

  .content-layout__metadata :global(.tag-list) {
    margin-inline-start: auto;
  }

  .content-layout__body {
    display: grid;
    grid-template-columns: minmax(10rem, 0.36fr) minmax(0, 1fr);
    gap: clamp(2rem, 8vw, 8rem);
    align-items: start;
    padding-block-start: clamp(3rem, 7vw, 6rem);
  }

  .content-layout__rail {
    position: sticky;
    top: calc(var(--site-header-height) + 2rem);
  }

  .content-layout__body--without-rail {
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
  }

  .content-layout__footer {
    display: flex;
    justify-content: flex-end;
    padding-block-start: clamp(4rem, 8vw, 7rem);
  }

  @media (max-width: 64rem) {
    .content-layout__body {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
    }

    .content-layout__rail {
      position: static;
      width: min(100%, var(--reading-width));
    }
  }

  @media (max-width: 56rem) {
    .content-layout__metadata :global(.tag-list) {
      width: 100%;
      margin-inline-start: 0;
    }
  }
</style>
