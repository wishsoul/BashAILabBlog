---
import type { Locale } from "../../config/site";
import { SITE } from "../../config/site";
import { getUi } from "../../i18n";
import { localizedPath } from "../../lib/localized-content";
import { withBase } from "../../lib/urls";
import ExternalLink from "../content/ExternalLink.astro";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const ui = getUi(lang);
const year = new Date().getFullYear();
const resumeUrl = SITE.resumeDownload
  ? withBase(SITE.resumeDownload)
  : withBase(localizedPath(lang, "/resume/"));
---

<footer class="site-footer">
  <div class="site-frame site-footer__grid">
    <div class="site-footer__identity flow">
      <p class="site-footer__brand">{ui.brand}</p>
      <p class="site-footer__summary">{ui.footer.summary}</p>
    </div>

    <nav aria-label={ui.footer.navigation}>
      <ul class="site-footer__links">
        <li>
          <ExternalLink
            href={SITE.github}
            newWindowLabel={ui.common.opensNewTab}
          >
            {ui.nav.github}
          </ExternalLink>
        </li>
        {
          SITE.email && (
            <li>
              <a href={`mailto:${SITE.email}`}>{ui.footer.email}</a>
            </li>
          )
        }
        <li><a href={resumeUrl}>{ui.footer.resume}</a></li>
        <li><a href={withBase("/rss.xml")}>{ui.footer.rss}</a></li>
      </ul>
    </nav>

    <div class="site-footer__legal">
      <p>© {year} {ui.brand}. {ui.footer.copyright}</p>
      <p>
        <ExternalLink
          href="https://astro.build"
          newWindowLabel={ui.common.opensNewTab}
        >
          {ui.footer.builtWithAstro}
        </ExternalLink>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: clamp(5rem, 12vw, 10rem);
    border-block-start: 1px solid var(--color-border);
  }

  .site-footer__grid {
    display: grid;
    gap: 3rem 2rem;
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 2rem;
  }

  .site-footer__identity {
    --flow-space: 0.75rem;
  }

  .site-footer__brand,
  .site-footer__summary,
  .site-footer__legal p {
    margin: 0;
  }

  .site-footer__brand {
    font-size: var(--font-size-md);
    font-weight: 560;
    letter-spacing: -0.025em;
  }

  .site-footer__summary {
    max-width: 34rem;
    color: var(--color-text-secondary);
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    padding: 0;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    list-style: none;
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    grid-column: 1 / -1;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
  }

  @media (min-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: minmax(0, 2fr) minmax(15rem, 1fr);
    }

    .site-footer__links {
      justify-content: flex-end;
    }
  }
</style>
