---
interface Props {
  before: string;
  after: string;
  beforeLabel?: string;
  afterLabel?: string;
}

const {
  before,
  after,
  beforeLabel = "Before",
  afterLabel = "After",
} = Astro.props;
---

<dl class="before-after">
  <div>
    <dt>{beforeLabel}</dt>
    <dd>{before}</dd>
  </div>
  <div>
    <dt>{afterLabel}</dt>
    <dd>{after}</dd>
  </div>
</dl>

<style>
  .before-after {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 2rem 0;
    border: 1px solid var(--color-border);
    background: var(--color-border);
  }

  .before-after div {
    padding: 1.25rem;
    background: var(--color-surface);
  }

  .before-after dt {
    margin-block-end: 0.65rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .before-after dd {
    margin: 0;
    line-height: 1.5;
  }

  @media (max-width: 34rem) {
    .before-after {
      grid-template-columns: 1fr;
    }
  }
</style>
