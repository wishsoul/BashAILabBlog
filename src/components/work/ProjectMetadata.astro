---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../../config/site";
import { getUi } from "../../i18n";
import { displayContentLabel } from "../../lib/content-labels";
import StatusIndicator from "./StatusIndicator.astro";

interface Props {
  entry: CollectionEntry<"work">;
  locale?: Locale;
}

const { entry, locale = entry.data.lang } = Astro.props;
const ui = getUi(locale);
const startedAt = entry.data.startedAt?.toLocaleDateString(
  locale === "zh" ? "zh-CN" : "en",
  {
    year: "numeric",
    month: "long",
  },
);
---

<dl class="project-metadata" data-project-metadata>
  <div>
    <dt>{ui.metadata.status}</dt>
    <dd><StatusIndicator status={entry.data.status} locale={locale} /></dd>
  </div>
  <div>
    <dt>{ui.metadata.category}</dt>
    <dd>{displayContentLabel(locale, entry.data.category)}</dd>
  </div>
  <div>
    <dt>{ui.metadata.platform}</dt>
    <dd>{entry.data.platform}</dd>
  </div>
  <div class="project-metadata__role">
    <dt>{ui.metadata.role}</dt>
    <dd>{entry.data.role}</dd>
  </div>
  {
    entry.data.year !== null && (
      <div>
        <dt>{ui.metadata.year}</dt>
        <dd>{entry.data.year}</dd>
      </div>
    )
  }
  {
    startedAt && (
      <div>
        <dt>{ui.metadata.started}</dt>
        <dd>{startedAt}</dd>
      </div>
    )
  }
</dl>

<style>
  .project-metadata {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 0;
    margin: 0;
    border-block-start: 1px solid var(--color-border);
  }

  .project-metadata > div {
    min-width: 0;
    padding: 1.1rem 1.25rem 1.35rem 0;
    border-block-end: 1px solid var(--color-border);
  }

  .project-metadata__role {
    grid-column: span 2;
  }

  .project-metadata dt {
    margin-block-end: 0.65rem;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-metadata dd {
    margin: 0;
    overflow-wrap: anywhere;
    font-size: var(--font-size-sm);
  }

  @media (max-width: 35rem) {
    .project-metadata {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .project-metadata__role {
      grid-column: span 2;
    }
  }
</style>
