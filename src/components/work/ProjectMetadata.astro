---
import type { CollectionEntry } from "astro:content";
import StatusIndicator from "./StatusIndicator.astro";

interface Props {
  entry: CollectionEntry<"work">;
}

const { entry } = Astro.props;
const startedAt = entry.data.startedAt?.toLocaleDateString("en", {
  year: "numeric",
  month: "long",
});
---

<dl class="project-metadata" data-project-metadata>
  <div>
    <dt>Status</dt>
    <dd><StatusIndicator status={entry.data.status} /></dd>
  </div>
  <div>
    <dt>Category</dt>
    <dd>{entry.data.category}</dd>
  </div>
  <div>
    <dt>Platform</dt>
    <dd>{entry.data.platform}</dd>
  </div>
  <div class="project-metadata__role">
    <dt>Role</dt>
    <dd>{entry.data.role}</dd>
  </div>
  {
    entry.data.year !== null && (
      <div>
        <dt>Year</dt>
        <dd>{entry.data.year}</dd>
      </div>
    )
  }
  {
    startedAt && (
      <div>
        <dt>Started</dt>
        <dd>{startedAt}</dd>
      </div>
    )
  }
</dl>

<style>
  .project-metadata {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 0;
    margin: 0;
    border-block-start: 1px solid var(--color-border);
  }

  .project-metadata > div {
    min-width: 0;
    padding: 1.1rem 1.25rem 1.35rem 0;
    border-block-end: 1px solid var(--color-border);
  }

  .project-metadata__role {
    grid-column: span 2;
  }

  .project-metadata dt {
    margin-block-end: 0.65rem;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-metadata dd {
    margin: 0;
    overflow-wrap: anywhere;
    font-size: var(--font-size-sm);
  }

  @media (max-width: 35rem) {
    .project-metadata {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .project-metadata__role {
      grid-column: span 2;
    }
  }
</style>
