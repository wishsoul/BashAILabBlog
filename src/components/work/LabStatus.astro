---
import type { CollectionEntry } from "astro:content";
import StatusIndicator from "./StatusIndicator.astro";

interface Props {
  entries: CollectionEntry<"work">[];
}

const { entries } = Astro.props;
---

<ul class="lab-status">
  {
    entries.map((entry, index) => (
      <li data-content-id={entry.id}>
        <span class="lab-status__number" aria-hidden="true">
          {String(index + 1).padStart(2, "0")}
        </span>
        <strong data-status-project>{entry.data.title}</strong>
        <span class="lab-status__scope">
          {entry.data.category} / {entry.data.platform}
        </span>
        <StatusIndicator status={entry.data.status} />
      </li>
    ))
  }
</ul>

<style>
  .lab-status {
    padding: 0;
    margin: 0;
    border-block-start: 1px solid var(--color-border);
    list-style: none;
  }

  .lab-status li {
    display: grid;
    grid-template-columns: 3rem minmax(10rem, 0.8fr) minmax(14rem, 1.2fr) auto;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.35rem;
    border-block-end: 1px solid var(--color-border);
  }

  .lab-status__number {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
  }

  .lab-status strong {
    font-size: var(--font-size-sm);
    font-weight: 560;
  }

  .lab-status__scope {
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
  }

  @media (max-width: 47.999rem) {
    .lab-status li {
      grid-template-columns: 2rem minmax(0, 1fr) auto;
      gap: 0.5rem 0.75rem;
    }

    .lab-status__scope {
      grid-column: 2 / -1;
    }
  }

  @media (max-width: 23rem) {
    .lab-status li {
      grid-template-columns: 1.75rem minmax(0, 1fr);
    }

    .lab-status :global(.status-indicator) {
      grid-column: 2;
    }

    .lab-status__scope {
      grid-column: 2;
    }
  }
</style>
