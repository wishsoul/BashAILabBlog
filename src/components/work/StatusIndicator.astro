---
interface Props {
  status: string;
}

const { status } = Astro.props;
---

<span
  class="status-indicator"
  data-status={status.toLowerCase()}
  data-status-value
>
  <span class="status-indicator__dot" aria-hidden="true"></span>
  {status}
</span>

<style>
  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    line-height: 1.4;
  }

  .status-indicator__dot {
    width: 0.45rem;
    height: 0.45rem;
    flex: 0 0 auto;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
  }

  .status-indicator[data-status="active"] .status-indicator__dot,
  .status-indicator[data-status="building"] .status-indicator__dot,
  .status-indicator[data-status="testing"] .status-indicator__dot,
  .status-indicator[data-status="shipped"] .status-indicator__dot {
    background: var(--color-accent);
  }

  .status-indicator[data-status="researching"] .status-indicator__dot,
  .status-indicator[data-status="exploring"] .status-indicator__dot,
  .status-indicator[data-status="designing"] .status-indicator__dot {
    background: color-mix(in srgb, var(--color-accent) 32%, transparent);
  }
</style>
