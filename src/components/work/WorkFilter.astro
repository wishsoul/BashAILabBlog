---
import type { Locale } from "../../config/site";
import { getUi } from "../../i18n";
import { displayContentLabel } from "../../lib/content-labels";

interface Props {
  categories: readonly string[];
  locale?: Locale;
}

const { categories, locale = "en" } = Astro.props;
const ui = getUi(locale);
const filters = ["All", ...categories];
---

<div class="work-filter" data-work-filter>
  <p id="work-filter-label" class="meta-label">{ui.archive.filterByCategory}</p>
  <div class="work-filter__controls" aria-labelledby="work-filter-label">
    {
      filters.map((filter) => (
        <button
          type="button"
          data-work-filter-button
          data-category={filter}
          aria-pressed={filter === "All" ? "true" : "false"}
        >
          {filter === "All"
            ? ui.status.all
            : displayContentLabel(locale, filter)}
        </button>
      ))
    }
  </div>
  <noscript>
    <p class="work-filter__note">{ui.archive.allProjectsShown}</p>
  </noscript>
</div>

<script>
  const filterRoot = document.querySelector<HTMLElement>("[data-work-filter]");
  const filterButtons = [
    ...(filterRoot?.querySelectorAll<HTMLButtonElement>(
      "[data-work-filter-button]",
    ) ?? []),
  ];
  const projectItems = [
    ...document.querySelectorAll<HTMLElement>("[data-project-list-item]"),
  ];
  const availableFilters = new Set(
    filterButtons.map((button) => button.dataset.category),
  );
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  );
  let activeFilterTransition: ViewTransition | undefined;
  let requestedFilter = "All";
  let filterRequestVersion = 0;

  for (const item of projectItems) {
    const transitionName = item.dataset.projectTransitionName;
    if (transitionName) item.style.viewTransitionName = transitionName;
  }

  function filterFromUrl() {
    const requested = new URL(window.location.href).searchParams.get(
      "category",
    );
    return requested && availableFilters.has(requested) ? requested : "All";
  }

  function updateFilter(filter: string, persist: boolean) {
    for (const button of filterButtons) {
      button.setAttribute(
        "aria-pressed",
        String(button.dataset.category === filter),
      );
    }

    for (const item of projectItems) {
      item.hidden = filter !== "All" && item.dataset.projectCategory !== filter;
    }

    if (persist) {
      persistFilter(filter);
    }
  }

  function persistFilter(filter: string) {
    const url = new URL(window.location.href);
    if (filter === "All") url.searchParams.delete("category");
    else url.searchParams.set("category", filter);
    window.history.pushState({}, "", url);
  }

  function runFilter(
    filter: string,
    shouldPersist: boolean,
    shouldAnimate: boolean,
  ) {
    const isSelected = requestedFilter === filter;
    requestedFilter = filter;
    const requestVersion = ++filterRequestVersion;
    if (
      !shouldAnimate ||
      prefersReducedMotion.matches ||
      !document.startViewTransition ||
      isSelected
    ) {
      activeFilterTransition?.skipTransition();
      activeFilterTransition = undefined;
      delete document.documentElement.dataset.workFilterTransition;
      updateFilter(filter, shouldPersist);
      return;
    }

    if (shouldPersist) persistFilter(filter);
    activeFilterTransition?.skipTransition();
    document.documentElement.dataset.workFilterTransition = "true";
    const transition = document.startViewTransition(() => {
      if (requestVersion !== filterRequestVersion) return;
      updateFilter(filter, false);
    });
    activeFilterTransition = transition;
    void transition.finished
      .catch(() => {})
      .finally(() => {
        if (activeFilterTransition !== transition) return;
        delete document.documentElement.dataset.workFilterTransition;
        activeFilterTransition = undefined;
      });
  }

  for (const button of filterButtons) {
    button.addEventListener("click", () => {
      const filter = button.dataset.category;
      if (!filter) return;
      runFilter(filter, true, true);
    });
  }

  window.addEventListener("popstate", () =>
    runFilter(filterFromUrl(), false, false),
  );
  runFilter(filterFromUrl(), false, false);
</script>

<style>
  .work-filter {
    display: grid;
    grid-template-columns: minmax(9rem, 0.35fr) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
    padding-block: 1.25rem;
    border-block: 1px solid var(--color-border);
  }

  .work-filter > p {
    margin: 0;
  }

  .work-filter__controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .work-filter button {
    position: relative;
    min-height: 2.5rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-text-secondary);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    transition: transform var(--duration-press) var(--ease-out);
  }

  .work-filter button:active {
    transform: scale(0.97);
  }

  .work-filter button::before {
    display: inline-block;
    width: 0.34rem;
    height: 0.34rem;
    margin-inline-end: 0.55rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    content: "";
  }

  .work-filter button[aria-pressed="true"] {
    color: var(--color-text);
  }

  @media (hover: hover) and (pointer: fine) {
    .work-filter button:hover {
      color: var(--color-text);
    }
  }

  .work-filter button[aria-pressed="true"]::before {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }

  .work-filter__note {
    grid-column: 2;
    color: var(--color-text-secondary);
    font-size: var(--font-size-xs);
  }

  :global(html[data-work-filter-transition="true"]::view-transition-old(*)) {
    animation: work-filter-fade-out 120ms linear;
  }

  :global(html[data-work-filter-transition="true"]::view-transition-new(*)) {
    animation: work-filter-enter 180ms var(--ease-out);
  }

  :global(html[data-work-filter-transition="true"]::view-transition-group(*)) {
    animation-duration: var(--duration-layout);
    animation-timing-function: var(--ease-in-out);
  }

  :global(html[data-work-filter-transition="true"]::view-transition-old(root)),
  :global(html[data-work-filter-transition="true"]::view-transition-new(root)),
  :global(
    html[data-work-filter-transition="true"]::view-transition-group(root)
  ) {
    animation: none;
  }

  @keyframes work-filter-fade-out {
    to {
      opacity: 0;
    }
  }

  @keyframes work-filter-enter {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-filter button {
      transition: none;
    }

    .work-filter button:active {
      transform: none;
    }

    :global(html[data-work-filter-transition="true"]::view-transition-old(*)),
    :global(html[data-work-filter-transition="true"]::view-transition-new(*)),
    :global(
      html[data-work-filter-transition="true"]::view-transition-group(*)
    ) {
      animation: none;
    }
  }

  @media (max-width: 40rem) {
    .work-filter {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .work-filter__controls {
      gap-inline: 1.1rem;
    }

    .work-filter__note {
      grid-column: 1;
    }
  }
</style>
