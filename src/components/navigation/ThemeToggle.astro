---
import type { Locale } from "../../config/site";
import { getUi } from "../../i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const ui = getUi(lang);
---

<button
  class="theme-toggle"
  type="button"
  aria-label={ui.header.useDarkTheme}
  title={ui.header.useDarkTheme}
  data-theme-toggle
  data-use-light-theme={ui.header.useLightTheme}
  data-use-dark-theme={ui.header.useDarkTheme}
>
  <span class="theme-toggle__orbit" aria-hidden="true">
    <span class="theme-toggle__disc"></span>
  </span>
</button>

<script>
  const root = document.documentElement;
  const toggles = document.querySelectorAll<HTMLButtonElement>(
    "[data-theme-toggle]",
  );
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  );
  let activeThemeTransition: ViewTransition | undefined;
  let themeRequestVersion = 0;

  function updateControls(theme: "light" | "dark") {
    for (const toggle of toggles) {
      const label =
        theme === "dark"
          ? toggle.dataset.useLightTheme
          : toggle.dataset.useDarkTheme;

      if (!label) continue;
      toggle.dataset.currentTheme = theme;
      toggle.setAttribute("aria-label", label);
      toggle.title = label;
    }
  }

  function persistTheme(theme: "light" | "dark") {
    try {
      localStorage.theme = theme;
    } catch {
      // The visual choice still applies when storage is unavailable.
    }
  }

  function applyTheme(theme: "light" | "dark") {
    root.dataset.theme = theme;
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute("content", theme === "dark" ? "#0b0b0c" : "#f5f5f1");

    updateControls(theme);
  }

  const initialTheme = root.dataset.theme === "dark" ? "dark" : "light";
  let requestedTheme: "light" | "dark" = initialTheme;
  applyTheme(initialTheme);

  for (const toggle of toggles) {
    toggle.addEventListener("click", () => {
      const nextTheme = requestedTheme === "dark" ? "light" : "dark";
      requestedTheme = nextTheme;
      const requestVersion = ++themeRequestVersion;
      persistTheme(nextTheme);

      if (prefersReducedMotion.matches || !document.startViewTransition) {
        applyTheme(nextTheme);
        return;
      }

      activeThemeTransition?.skipTransition();
      root.dataset.themeTransition = "true";
      const transition = document.startViewTransition(() => {
        if (requestVersion !== themeRequestVersion) return;
        applyTheme(nextTheme);
      });
      activeThemeTransition = transition;
      void transition.finished
        .catch(() => {})
        .finally(() => {
          if (activeThemeTransition !== transition) return;
          if (root.dataset.theme !== requestedTheme) applyTheme(requestedTheme);
          delete root.dataset.themeTransition;
          activeThemeTransition = undefined;
        });
    });
  }
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    place-items: center;
    transition: transform var(--duration-press) var(--ease-out);
  }

  .theme-toggle:active {
    transform: scale(0.97);
  }

  .theme-toggle__orbit {
    position: relative;
    display: block;
    width: 1rem;
    height: 1rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    color: var(--color-text-secondary);
  }

  .theme-toggle__disc {
    position: absolute;
    inset: 2px 2px 2px 50%;
    border-radius: 0 1rem 1rem 0;
    background: currentColor;
    transition: transform var(--duration-brand) var(--ease-in-out);
    transform-origin: left center;
  }

  @media (hover: hover) and (pointer: fine) {
    .theme-toggle:hover .theme-toggle__orbit {
      color: var(--color-text);
    }
  }

  .theme-toggle[data-current-theme="dark"] .theme-toggle__disc {
    transform: rotate(180deg);
  }

  :global(::view-transition) {
    pointer-events: none;
  }

  :global(
    html[data-theme-transition="true"]::view-transition-image-pair(root)
  ) {
    isolation: isolate;
  }

  :global(html[data-theme-transition="true"]::view-transition-old(root)) {
    animation: none;
    mix-blend-mode: normal;
  }

  :global(html[data-theme-transition="true"]::view-transition-new(root)) {
    animation: theme-crossfade var(--duration-brand) var(--ease-in-out) both;
    mix-blend-mode: normal;
    will-change: opacity;
  }

  @keyframes theme-crossfade {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle {
      transition: none;
    }

    .theme-toggle:active {
      transform: none;
    }

    .theme-toggle__disc {
      transition: none;
    }

    :global(html[data-theme-transition="true"]::view-transition-new(root)) {
      animation: none;
    }
  }
</style>
