---
import type { Locale } from "../../config/site";
import { getUi } from "../../i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const ui = getUi(lang);
---

<button
  class="theme-toggle"
  type="button"
  aria-label={ui.header.useDarkTheme}
  title={ui.header.useDarkTheme}
  data-theme-toggle
  data-use-light-theme={ui.header.useLightTheme}
  data-use-dark-theme={ui.header.useDarkTheme}
>
  <span class="theme-toggle__orbit" aria-hidden="true">
    <span class="theme-toggle__disc"></span>
  </span>
</button>

<script>
  const root = document.documentElement;
  const toggles = document.querySelectorAll<HTMLButtonElement>(
    "[data-theme-toggle]",
  );

  function updateControls(theme: "light" | "dark") {
    for (const toggle of toggles) {
      const label =
        theme === "dark"
          ? toggle.dataset.useLightTheme
          : toggle.dataset.useDarkTheme;

      if (!label) continue;
      toggle.dataset.currentTheme = theme;
      toggle.setAttribute("aria-label", label);
      toggle.title = label;
    }
  }

  function applyTheme(theme: "light" | "dark", persist = false) {
    root.dataset.theme = theme;
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute("content", theme === "dark" ? "#0b0b0c" : "#f5f5f1");

    if (persist) {
      try {
        localStorage.theme = theme;
      } catch {
        // The visual choice still applies when storage is unavailable.
      }
    }

    updateControls(theme);
  }

  const initialTheme = root.dataset.theme === "dark" ? "dark" : "light";
  applyTheme(initialTheme);

  for (const toggle of toggles) {
    toggle.addEventListener("click", () => {
      const nextTheme = root.dataset.theme === "dark" ? "light" : "dark";
      applyTheme(nextTheme, true);
    });
  }
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    place-items: center;
  }

  .theme-toggle__orbit {
    position: relative;
    display: block;
    width: 1rem;
    height: 1rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    color: var(--color-text-secondary);
  }

  .theme-toggle__disc {
    position: absolute;
    inset: 2px 2px 2px 50%;
    border-radius: 0 1rem 1rem 0;
    background: currentColor;
    transition: transform 160ms ease;
    transform-origin: left center;
  }

  .theme-toggle:hover .theme-toggle__orbit {
    color: var(--color-text);
  }

  .theme-toggle[data-current-theme="dark"] .theme-toggle__disc {
    transform: rotate(180deg);
  }
</style>
