---
import type { Locale } from "../../config/site";
import { getUi } from "../../i18n";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  locale?: Locale;
}

const { headings, locale = "en" } = Astro.props;
const ui = getUi(locale);
const items = headings.filter(
  (heading) => heading.depth >= 2 && heading.depth <= 3,
);
---

{
  items.length > 0 && (
    <nav
      class="table-of-contents"
      aria-label={ui.accessibility.tableOfContents}
    >
      <p class="meta-label">{ui.accessibility.onThisPage}</p>
      <ol>
        {items.map((heading) => (
          <li
            class:list={{ "table-of-contents__subitem": heading.depth === 3 }}
          >
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .table-of-contents {
    border-inline-start: 1px solid var(--color-border);
    padding-inline-start: 1rem;
  }

  .table-of-contents > p {
    margin: 0 0 0.85rem;
  }

  .table-of-contents ol {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .table-of-contents a {
    color: var(--color-text-secondary);
    font-size: var(--font-size-xs);
    line-height: 1.45;
    text-decoration: none;
  }

  .table-of-contents a:hover,
  .table-of-contents a:focus-visible {
    color: var(--color-text);
    text-decoration: underline;
  }

  .table-of-contents__subitem {
    padding-inline-start: 0.75rem;
  }
</style>
