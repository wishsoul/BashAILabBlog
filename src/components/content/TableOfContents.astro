---
import type { Locale } from "../../config/site";
import { getUi } from "../../i18n";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  locale?: Locale;
}

const { headings, locale = "en" } = Astro.props;
const ui = getUi(locale);
let sectionIndex = 0;
const items = headings
  .filter((heading) => heading.depth >= 2 && heading.depth <= 3)
  .map((heading) => ({
    ...heading,
    index:
      heading.depth === 2 ? String(++sectionIndex).padStart(2, "0") : undefined,
  }));
---

{
  items.length > 0 && (
    <>
      <nav
        class="table-of-contents table-of-contents--desktop"
        aria-label={ui.accessibility.tableOfContents}
      >
        <p class="meta-label">{ui.accessibility.onThisPage}</p>
        <ol>
          {items.map((heading) => (
            <li
              class:list={{ "table-of-contents__subitem": heading.depth === 3 }}
            >
              <span class="table-of-contents__index" aria-hidden="true">
                {heading.index ?? ""}
              </span>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </nav>

      <details class="table-of-contents table-of-contents--mobile">
        <summary class="meta-label">{ui.accessibility.onThisPage}</summary>
        <nav aria-label={ui.accessibility.tableOfContents}>
          <ol>
            {items.map((heading) => (
              <li
                class:list={{
                  "table-of-contents__subitem": heading.depth === 3,
                }}
              >
                <span class="table-of-contents__index" aria-hidden="true">
                  {heading.index ?? ""}
                </span>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
    </>
  )
}

<style>
  .table-of-contents {
    padding-inline-start: 1rem;
    border-inline-start: 1px solid var(--color-border);
  }

  .table-of-contents > p {
    margin: 0 0 0.85rem;
  }

  .table-of-contents--mobile {
    display: none;
  }

  .table-of-contents ol {
    display: grid;
    gap: 0.6rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .table-of-contents li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.5rem;
    align-items: baseline;
  }

  .table-of-contents__index {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
  }

  .table-of-contents a {
    color: var(--color-text-secondary);
    font-size: var(--font-size-xs);
    line-height: 1.45;
    text-decoration: none;
  }

  .table-of-contents a:hover,
  .table-of-contents a:focus-visible {
    color: var(--color-text);
    text-decoration: underline;
  }

  .table-of-contents__subitem {
    padding-inline-start: 0.75rem;
  }

  .table-of-contents__subitem .table-of-contents__index::before {
    content: "—";
  }

  @media (max-width: 64rem) {
    .table-of-contents--desktop {
      display: none;
    }

    .table-of-contents--mobile {
      display: block;
      width: 100%;
      padding: 0;
      border: 1px solid var(--color-border);
    }

    .table-of-contents--mobile summary {
      display: flex;
      min-height: 2.75rem;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem 1rem;
      cursor: pointer;
      list-style: none;
    }

    .table-of-contents--mobile summary::-webkit-details-marker {
      display: none;
    }

    .table-of-contents--mobile summary::after {
      color: var(--color-accent);
      content: "+";
      font-size: var(--font-size-sm);
    }

    .table-of-contents--mobile[open] summary::after {
      content: "−";
    }

    .table-of-contents--mobile nav {
      padding: 0 1rem 1rem;
      border-block-start: 1px solid var(--color-border);
    }

    .table-of-contents--mobile ol {
      padding-block-start: 1rem;
    }
  }
</style>
