---
import type { CollectionEntry } from "astro:content";
import { getUi } from "../../i18n";
import { contentPath } from "../../lib/localized-content";
import BaseLayout from "../../layouts/BaseLayout.astro";

interface Props {
  entry: CollectionEntry<"pages">;
  translationPath?: string;
}

const { entry, translationPath } = Astro.props;
const locale = entry.data.lang;
const ui = getUi(locale);
const canonicalPath = contentPath(locale, "pages", entry.id);
---

<BaseLayout
  title={entry.data.seo.title}
  description={entry.data.seo.description}
  lang={entry.data.lang}
  canonicalPath={canonicalPath}
  translationPath={translationPath}
>
  <article class="site-frame editorial-page">
    <header class="editorial-page__header">
      <p class="meta-label">{ui.brand}</p>
      <h1 class="display-title">{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>
    </header>

    <div class="editorial-page__content prose" data-page-content>
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .editorial-page {
    padding-block: clamp(4rem, 9vw, 8rem) clamp(5rem, 10vw, 9rem);
  }

  .editorial-page__header {
    display: grid;
    gap: 1.5rem;
    max-width: 58rem;
    padding-block-end: clamp(3rem, 7vw, 6rem);
  }

  .editorial-page__header > p {
    margin: 0;
  }
</style>
