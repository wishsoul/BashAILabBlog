---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../../config/site";
import { getUi } from "../../i18n";
import { estimateReadingMinutes } from "../../lib/content";
import { displayContentLabel } from "../../lib/content-labels";
import { contentPath } from "../../lib/localized-content";
import { withBase } from "../../lib/urls";

interface Props {
  entry: CollectionEntry<"research">;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const ui = getUi(locale);
const publishedAt = entry.data.publishedAt;
const sourceText =
  "body" in entry && typeof entry.body === "string"
    ? entry.body
    : entry.data.description;
const readingMinutes =
  entry.data.readingMinutes ?? estimateReadingMinutes(sourceText);
const englishDateLabel = publishedAt
  ? [
      publishedAt.getUTCFullYear(),
      String(publishedAt.getUTCMonth() + 1).padStart(2, "0"),
      String(publishedAt.getUTCDate()).padStart(2, "0"),
    ].join(".")
  : "";
const dateLabel = publishedAt
  ? locale === "zh"
    ? new Intl.DateTimeFormat("zh-CN", {
        day: "numeric",
        month: "long",
        year: "numeric",
        timeZone: "UTC",
      }).format(publishedAt)
    : englishDateLabel
  : "";
const href = withBase(contentPath(locale, "research", entry.id));
---

<li class="article-item" data-content-id={entry.id} data-research-article>
  <article>
    {
      publishedAt && (
        <time datetime={publishedAt.toISOString().slice(0, 10)}>
          {dateLabel}
        </time>
      )
    }
    <div class="article-item__body">
      <p class="article-item__meta meta-label">
        <span>{displayContentLabel(locale, entry.data.category)}</span>
        <span>{displayContentLabel(locale, entry.data.status)}</span>
        <span>{readingMinutes} {ui.metadata.minutesRead}</span>
      </p>
      <h3>
        <a href={href}>
          <span data-article-title>{entry.data.title}</span>
          <span class="article-item__arrow" aria-hidden="true">↗</span>
        </a>
      </h3>
    </div>
  </article>
</li>

<style>
  .article-item {
    border-block-end: 1px solid var(--color-border);
  }

  .article-item article {
    display: grid;
    grid-template-columns: minmax(8rem, 0.32fr) minmax(0, 1fr);
    gap: 2rem;
    padding-block: clamp(1.75rem, 4vw, 3rem);
  }

  .article-item time {
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    letter-spacing: 0.04em;
  }

  .article-item__body {
    display: grid;
    gap: 1rem;
  }

  .article-item__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0;
  }

  .article-item h3 {
    margin: 0;
    font-size: var(--font-size-lg);
    font-weight: 520;
    letter-spacing: -0.035em;
    line-height: 1.2;
  }

  .article-item h3 a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    text-decoration: none;
  }

  .article-item__arrow {
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    transition: transform 160ms ease;
  }

  .article-item h3 a:hover .article-item__arrow {
    transform: translate(0.15rem, -0.15rem);
  }

  @media (max-width: 39.999rem) {
    .article-item article {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .article-item h3 a {
      gap: 1rem;
    }
  }
</style>
